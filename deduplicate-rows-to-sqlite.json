{
    "$schema": "https://raw.githubusercontent.com/TheCocoTeam/source-watcher-api/master/pipeline.schema.json",
    "notes": "Deduplicates sample people by ID, retaining the latest row according to updated_at, then writes the result to SQLite.",
    "steps": [
        {
            "type": "extractor",
            "name": "Csv",
            "options": {
                "filePath": "/var/www/html/.source-watcher/data/sample-duplicates.csv",
                "columns": ["id", "name", "updated_at"],
                "delimiter": ",",
                "enclosure": "\""
            },
            "x": 80,
            "y": 100
        },
        {
            "type": "transformer",
            "name": "DeduplicateRows",
            "options": {
                "keyFields": ["id"],
                "keep": "last",
                "orderField": "updated_at",
                "orderDirection": "asc"
            },
            "x": 300,
            "y": 100
        },
        {
            "type": "loader",
            "name": "Database",
            "options": {
                "driver": "pdo_sqlite",
                "tableName": "deduplicated_people",
                "path": "/var/www/html/.source-watcher/deduplicate-rows.db",
                "memory": false
            },
            "x": 520,
            "y": 100
        }
    ]
}
