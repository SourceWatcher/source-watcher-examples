{
    "$schema": "https://raw.githubusercontent.com/TheCocoTeam/source-watcher-api/master/pipeline.schema.json",
    "steps": [
        {
            "type": "extractor",
            "name": "Csv",
            "options": {
                "filePath": "/var/www/html/.source-watcher/data/sample-sequence.csv",
                "columns": ["id", "label"],
                "delimiter": ",",
                "enclosure": "\""
            },
            "x": 80,
            "y": 100
        },
        {
            "type": "transformer",
            "name": "SortRows",
            "options": {
                "fields": [
                    {
                        "field": "id",
                        "direction": "desc",
                        "type": "numeric",
                        "nulls": "last"
                    }
                ]
            },
            "x": 300,
            "y": 100
        },
        {
            "type": "loader",
            "name": "Database",
            "options": {
                "driver": "pdo_sqlite",
                "tableName": "sorted_sequence",
                "path": "/var/www/html/.source-watcher/sort-sequence.db",
                "memory": false
            },
            "x": 520,
            "y": 100
        }
    ]
}
