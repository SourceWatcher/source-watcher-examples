{
    "$schema": "https://raw.githubusercontent.com/TheCocoTeam/source-watcher-api/master/pipeline.schema.json",
    "notes": "Creates a display_name field from the existing name and id columns, then writes the enriched rows to SQLite.",
    "steps": [
        {
            "type": "extractor",
            "name": "Csv",
            "options": {
                "filePath": "/var/www/html/.source-watcher/data/sample-duplicates.csv",
                "columns": ["id", "name", "updated_at"],
                "delimiter": ",",
                "enclosure": "\""
            },
            "x": 80,
            "y": 100
        },
        {
            "type": "transformer",
            "name": "DeriveField",
            "options": {
                "targetField": "display_name",
                "expression": "concat(name, ' (#', id, ')')"
            },
            "x": 300,
            "y": 100
        },
        {
            "type": "loader",
            "name": "Database",
            "options": {
                "driver": "pdo_sqlite",
                "tableName": "people_with_display_name",
                "path": "/var/www/html/.source-watcher/derive-field.db",
                "memory": false
            },
            "x": 520,
            "y": 100
        }
    ]
}
