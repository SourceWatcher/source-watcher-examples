{
  "$schema": "https://raw.githubusercontent.com/TheCocoTeam/source-watcher-api/master/pipeline.schema.json",
  "notes": "Demonstrates feeding transformed rows into an execution extractor by filtering the source sequence before finding its missing IDs.",
  "steps": [
    {
      "type": "extractor",
      "name": "Csv",
      "options": {
        "filePath": "/var/www/html/.source-watcher/data/sample-sequence.csv",
        "columns": [
          "id",
          "label"
        ],
        "delimiter": ",",
        "enclosure": "\""
      },
      "x": 40,
      "y": 100
    },
    {
      "type": "transformer",
      "name": "FilterRows",
      "options": {
        "match": "all",
        "conditions": [
          {
            "field": "id",
            "operator": "greaterThan",
            "value": 1
          }
        ]
      },
      "x": 250,
      "y": 100
    },
    {
      "type": "execution-extractor",
      "name": "FindMissingFromSequence",
      "options": {
        "filterField": "id"
      },
      "x": 470,
      "y": 100
    },
    {
      "type": "loader",
      "name": "Database",
      "options": {
        "driver": "pdo_sqlite",
        "tableName": "filtered_missing_ids",
        "path": "/var/www/html/.source-watcher/transformer-to-execution.db",
        "memory": false
      },
      "x": 710,
      "y": 100
    }
  ]
}
